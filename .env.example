NODE_ENV=development
PORT=5000

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/eve_diagnostics

# JWT
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=1d

# Payment simulation
# Probability (0-1) that a simulated payment succeeds
PAYMENT_SUCCESS_RATE=0.8

# ---- Optional: Redis (enables caching + background jobs) -------------------
# Leave unset to run without Redis: caching becomes a no-op and background
# jobs are disabled. Nothing else changes.
# REDIS_URL=redis://127.0.0.1:6379
# CACHE_TTL_SECONDS=60

# ---- Optional: background jobs (only active when REDIS_URL is set) ---------
# RUN_JOBS_IN_API=true               # false => run `npm run worker` separately
# WEBHOOK_RETRY_ATTEMPTS=5           # server-side retries before dead-lettering
# WEBHOOK_RETRY_BASE_DELAY_MS=2000   # exponential backoff base (2s, 4s, 8s, ...)
# WEBHOOK_STALE_SECONDS=60           # an unfinished webhook event older than this may be taken over
# PAYMENT_TIMEOUT_MINUTES=15         # PENDING payments older than this are failed by the reconciler
# RECONCILE_INTERVAL_SECONDS=300     # how often the reconciliation job runs
